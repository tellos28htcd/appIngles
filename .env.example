APP_NAME=AppIngles
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appingles
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (HTTPS) poner true: la cookie de sesión solo viaja cifrada.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. Con MAIL_MAILER=log los correos NO se envían: solo se escriben en storage/logs.
# Para enviar de verdad (invitaciones, recuperar contraseña) usa smtp con un proveedor:
#   Gmail:  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null  (requiere "contraseña de aplicación")
#   Brevo:  MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
#   Puerto 465 = MAIL_SCHEME=smtps
# Prueba: php artisan app:send-test-mail tu-correo@dominio.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@appingles.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super Administrador inicial (lo crea php artisan db:seed)
SUPER_ADMIN_NAME="Administrador AppIngles"
SUPER_ADMIN_EMAIL=admin@appingles.com
SUPER_ADMIN_PASSWORD=
